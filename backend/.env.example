# Copy these names into your backend host's Environment / Variables dashboard.
# Do not commit a real .env file. Spring Boot does not load .env automatically;
# use your host dashboard locally, or an explicit dotenv tool, to supply them.

# Required production profile and managed host port
SPRING_PROFILES_ACTIVE=prod
# PORT is injected by most hosts; set it only when your provider requires it.
# PORT=8080

# PostgreSQL (use the internal/private connection URL where the host offers one)
DB_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
DB_USERNAME=DATABASE_USER
DB_PASSWORD=replace-with-a-long-unique-password

# Generate a random value of at least 32 bytes. Keep it stable after launch,
# otherwise all active user sessions will be invalidated.
JWT_SECRET=replace-with-a-random-64-character-or-longer-secret

# Public URLs -- no trailing slash
FRONTEND_URL=https://www.example.com
CORS_ALLOWED_ORIGIN_PATTERNS=https://www.example.com,https://example.com
UPLOAD_BASE_URL=https://api.example.com/uploads

# Local disk only works on a persistent disk. Set UPLOAD_DIR to that mounted path.
UPLOAD_DIR=/var/data/uploads

# NewsAPI (required by the current prod profile)
NEWS_API_KEY=replace-with-newsapi-key
# Never show cached headlines older than this many hours.
NEWS_MAX_AGE_HOURS=24

